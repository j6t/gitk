msgstr "<Right>, x, l\tGaan vorentoe in geskiedenislys"

#, tcl-format
msgid "<%s-n>\tGo to n-th parent of current commit in history list"
msgstr "<%s-n>\tGaan na n-de ouer van huidige vaslegging in geskiedenislys"

