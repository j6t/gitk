msgstr "<%s-Down>\tRol vasleggingslys een reël af"

#, tcl-format
msgid "<%s-PageUp>\tScroll commit list up one page"
msgstr "<%s-PageUp>\tRol vasleggingslys een bladsy op"

#, tcl-format
msgid "<%s-PageDown>\tScroll commit list down one page"
msgstr "<%s-PageDown>\tRol vasleggingslys een bladsy af"

msgid "<Shift-Up>\tFind backwards (upwards, later commits)"
msgstr "<Shift-Up>\tVind terugwaarts (opwaarts, latere vasleggings)"

