#, tcl-format
msgid "<%s-Q>\t\tQuit"
msgstr "<%s-Q>\t\tVerlaat"

#, tcl-format
msgid "<%s-W>\t\tClose window"
msgstr "<%s-W>\t\tSluit venster"

